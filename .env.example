# Copy to .env (never commit .env). Keys are only read by the local server.

# Primary provider: gemini (default) or openai (any OpenAI-compatible API)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional fallback, used if the primary request fails. Groq shown; Mistral works too:
#   FALLBACK_BASE_URL=https://api.mistral.ai/v1  FALLBACK_MODEL=mistral-small-latest
FALLBACK_PROVIDER=openai
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=llama-3.3-70b-versatile

PORT=8787
